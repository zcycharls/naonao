{
  "name": "naonao-focus-quest",
  "version": "1.1.0",
  "description": "由可选 AI 与 Hermes 任务导演驱动的现实任务冒险游戏",
  "main": "steam-main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run verify:source && npm run test:smoke",
    "test:unit": "node scripts/steam-game-tests.js && node scripts/steam-director-tests.js && node scripts/steam-main-tests.js && node scripts/steam-renderer-tests.js && node scripts/verify-steam-release-tests.js",
    "test:smoke": "node scripts/steam-smoke.js",
    "test:packaged": "node scripts/steam-smoke.js --packaged",
    "verify:source": "node scripts/verify-steam-release.js --source-only",
    "verify:steam": "node scripts/verify-steam-release.js",
    "verify:submission": "node scripts/verify-steam-submission.js",
    "release:check": "npm test && npm run steam:depot && npm run verify:steam && npm run test:packaged",
    "pack": "npm run steam:depot",
    "build": "npm run steam:depot",
    "steam:depot": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "help.naonao.focusquest",
    "productName": "Naonao Focus Quest",
    "executableName": "NaonaoFocusQuest",
    "directories": {
      "output": "dist/steam"
    },
    "files": [
      "steam-main.js",
      "steam-preload.js",
      "steam-companion-preload.js",
      "app/steam-game.html",
      "app/steam-game.css",
      "app/steam-game.js",
      "app/steam-companion.html",
      "app/steam-companion.css",
      "app/steam-companion.js",
      "app/js/steam-game-engine.js",
      "app/js/steam-director-engine.js",
      "app/assets/naonao-pet.png",
      "app/assets/hat.png",
      "app/assets/metal-brushed-light.png",
      "app/assets/metal-brushed-dark.png"
    ],
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraResources": [],
    "win": {
      "icon": "build/icon.ico"
    },
    "electronVersion": "42.3.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "author": "zcycharls"
}
