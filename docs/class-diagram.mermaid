classDiagram
    class StatsStore {
        +read() Object
        +write(data) void
        +init() void
        +recordPomo(durationSeconds) void
        +todayPomos() number
        +weekPomos() number
        +totalFocusMin() number
        +streakDays() number
        +dailyMap(days) Object
        +calendarWeeks() Array
    }

    class StatsRenderer {
        +renderAll() void
        +renderPomoCard() void
        +renderFridgeCard() void
        +renderCalendar() void
        +renderTrend() void
        +switchTrend(days) void
    }

    class Freezer {
        +freezeIdea(text) void
        +thawIdea(id) void
        +useIdea(id) void
        +renderFreezerList() void
    }

    StatsRenderer --> StatsStore : reads
    StatsRenderer --> Freezer : reads freezerItems
